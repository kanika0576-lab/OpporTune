# ─────────────────────────────────────────────────────────────
# OpporTune environment variables
# Copy this file to `.env.local` and fill in the real value.
# NEVER commit `.env.local` or any file containing a real key.
# ─────────────────────────────────────────────────────────────

# Server-side ONLY. Read by the Vercel serverless function /api/search.ts.
# This variable is NOT prefixed with VITE_, so Vite will never expose it
# to the browser bundle. Never add VITE_ to it.
TINYFISH_API_KEY=your_tinyfish_api_key_here
